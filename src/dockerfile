FROM continuumio/miniconda3

ENV DEBIAN_FRONTEND=noninteractive

RUN conda create -n snvler python=3.11 -y && \
    conda install -n snvler -c conda-forge -c bioconda nanoqc porechop minimap2 samtools ivar -y && \
    conda clean -afy

WORKDIR /app

COPY . /app

RUN conda run -n snvler python -m pip install .

ENTRYPOINT ["conda", "run", "--no-capture-output", "-n", "snvler", "snvler"]
